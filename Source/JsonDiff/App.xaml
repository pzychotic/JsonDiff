<Application x:Class="JsonDiff.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Diff colors, shared by the panes and the status bar legend. -->
        <SolidColorBrush x:Key="UnmatchedBrush" Color="#FFFFC7CE" />
        <SolidColorBrush x:Key="ModifiedBrush" Color="#FFFFF0A0" />
        <SolidColorBrush x:Key="TypeChangedBrush" Color="#FFE2CCF7" />
        <SolidColorBrush x:Key="IgnoredBrush" Color="#FFEEEEEE" />
        <SolidColorBrush x:Key="IgnoredTextBrush" Color="#FF999999" />
        <LinearGradientBrush x:Key="GapBrush" MappingMode="Absolute" SpreadMethod="Repeat"
                             StartPoint="0,0" EndPoint="6,6">
            <GradientStop Color="#FFE6E6E6" Offset="0" />
            <GradientStop Color="#FFE6E6E6" Offset="0.5" />
            <GradientStop Color="#FFF6F6F6" Offset="0.5" />
            <GradientStop Color="#FFF6F6F6" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>
