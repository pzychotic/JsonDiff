<UserControl x:Class="JsonDiff.Views.JsonPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:beh="clr-namespace:JsonDiff.Behaviors"
             xmlns:m="clr-namespace:JsonDiff.Models"
             xmlns:vm="clr-namespace:JsonDiff.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilePaneViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="300" d:DesignWidth="400">
    <DockPanel>
        <!-- Header: file name, full path as tooltip -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Background="{DynamicResource PaneBackgroundBrush}">
            <!-- Content scrolling (CanContentScroll) keeps offsets in rows, identical for both panes. -->
            <ItemsControl ItemsSource="{Binding Lines}"
                          FontFamily="Consolas" FontSize="13"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <b:Interaction.Behaviors>
                    <beh:TopRowBehavior TopRow="{Binding TopRow}" ViewportRows="{Binding ViewportRows, Mode=OneWayToSource}" />
                </b:Interaction.Behaviors>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- Rows are DiffLines or FoldLines; each gets its template by type. -->
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type m:DiffLine}">
                        <Grid x:Name="Row" Height="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource GutterBackgroundBrush}"
                                    BorderBrush="{DynamicResource GutterBorderBrush}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding LineNumber}" Foreground="{DynamicResource GutterTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Border>
                            <TextBlock x:Name="Content" Grid.Column="1" VerticalAlignment="Center"
                                       Margin="6,0" Foreground="{DynamicResource TextBrush}"
                                       beh:SearchHighlight.Line="{Binding}"
                                       beh:SearchHighlight.Highlights="{Binding DataContext.SearchHighlights,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffLineKind.Unmatched}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource UnmatchedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffLineKind.Modified}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ModifiedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffLineKind.TypeChanged}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TypeChangedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffLineKind.Ignored}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource IgnoredBrush}" />
                                <Setter TargetName="Content" Property="Foreground" Value="{DynamicResource IgnoredTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffLineKind.Gap}">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource GapBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- Hidden unchanged rows; clicking shows them. -->
                    <DataTemplate DataType="{x:Type m:FoldLine}">
                        <Border Height="18" Background="{DynamicResource FoldBrush}" BorderBrush="{DynamicResource FoldBorderBrush}"
                                BorderThickness="0,1" Cursor="Hand" ToolTip="Click to show these lines">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                              Command="{Binding DataContext.ExpandFoldCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border.InputBindings>
                            <TextBlock Foreground="{DynamicResource FoldTextBrush}" FontStyle="Italic" VerticalAlignment="Center"
                                       Margin="58,0,6,0" Text="{Binding Count, StringFormat='⋯ {0} unchanged lines'}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <TextBlock Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                       Text="Drop a JSON file here, or use File ▸ Open. Dropping two files fills both sides.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
