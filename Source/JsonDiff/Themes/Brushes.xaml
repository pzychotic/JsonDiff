<!-- Brushes over the palette's colors; merged into each palette, so every theme gets its own brush instances.
     Reference these brushes with DynamicResource, so they change with the theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{DynamicResource PaneBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{DynamicResource SubtleTextColor}" />
    <SolidColorBrush x:Key="HintTextBrush" Color="{DynamicResource HintTextColor}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource ControlBorderColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{DynamicResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{DynamicResource HoverBorderColor}" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{DynamicResource PressedBackgroundColor}" />
    <SolidColorBrush x:Key="CheckedBackgroundBrush" Color="{DynamicResource CheckedBackgroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{DynamicResource DisabledTextColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{DynamicResource ScrollBarTrackColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{DynamicResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{DynamicResource ScrollBarThumbHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarArrowBrush" Color="{DynamicResource ScrollBarArrowColor}" />

    <!-- Line numbers -->
    <SolidColorBrush x:Key="GutterBackgroundBrush" Color="{DynamicResource GutterBackgroundColor}" />
    <SolidColorBrush x:Key="GutterBorderBrush" Color="{DynamicResource GutterBorderColor}" />
    <SolidColorBrush x:Key="GutterTextBrush" Color="{DynamicResource GutterTextColor}" />

    <!-- Diff colors, shared by the panes and the status bar legend. -->
    <SolidColorBrush x:Key="UnmatchedBrush" Color="{DynamicResource UnmatchedColor}" />
    <SolidColorBrush x:Key="ModifiedBrush" Color="{DynamicResource ModifiedColor}" />
    <SolidColorBrush x:Key="TypeChangedBrush" Color="{DynamicResource TypeChangedColor}" />
    <SolidColorBrush x:Key="IgnoredBrush" Color="{DynamicResource IgnoredColor}" />
    <SolidColorBrush x:Key="IgnoredTextBrush" Color="{DynamicResource IgnoredTextColor}" />
    <SolidColorBrush x:Key="FoldBrush" Color="{DynamicResource FoldColor}" />
    <SolidColorBrush x:Key="FoldBorderBrush" Color="{DynamicResource FoldBorderColor}" />
    <SolidColorBrush x:Key="FoldTextBrush" Color="{DynamicResource FoldTextColor}" />
    <LinearGradientBrush x:Key="GapBrush" MappingMode="Absolute" SpreadMethod="Repeat"
                         StartPoint="0,0" EndPoint="6,6">
        <GradientStop Color="{DynamicResource GapColor1}" Offset="0" />
        <GradientStop Color="{DynamicResource GapColor1}" Offset="0.5" />
        <GradientStop Color="{DynamicResource GapColor2}" Offset="0.5" />
        <GradientStop Color="{DynamicResource GapColor2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Search hits in the panes' text; the current one stands out. -->
    <SolidColorBrush x:Key="SearchMatchBrush" Color="{DynamicResource SearchMatchColor}" />
    <SolidColorBrush x:Key="SearchCurrentBrush" Color="{DynamicResource SearchCurrentColor}" />
    <SolidColorBrush x:Key="SearchCurrentTextBrush" Color="{DynamicResource SearchCurrentTextColor}" />

    <!-- Stronger variants for the thin marks of the overview bar. -->
    <SolidColorBrush x:Key="OverviewBackgroundBrush" Color="{DynamicResource OverviewBackgroundColor}" />
    <SolidColorBrush x:Key="OverviewSeparatorBrush" Color="{DynamicResource OverviewSeparatorColor}" />
    <SolidColorBrush x:Key="OverviewUnmatchedBrush" Color="{DynamicResource OverviewUnmatchedColor}" />
    <SolidColorBrush x:Key="OverviewModifiedBrush" Color="{DynamicResource OverviewModifiedColor}" />
    <SolidColorBrush x:Key="OverviewTypeChangedBrush" Color="{DynamicResource OverviewTypeChangedColor}" />
    <SolidColorBrush x:Key="OverviewIgnoredBrush" Color="{DynamicResource OverviewIgnoredColor}" />
    <SolidColorBrush x:Key="OverviewSearchBrush" Color="{DynamicResource OverviewSearchColor}" />
    <SolidColorBrush x:Key="OverviewViewportBrush" Color="{DynamicResource OverviewViewportColor}" />
    <SolidColorBrush x:Key="OverviewViewportBorderBrush" Color="{DynamicResource OverviewViewportBorderColor}" />
</ResourceDictionary>
