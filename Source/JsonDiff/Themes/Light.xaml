<!-- The light palette. Every theme defines the same keys; Brushes.xaml and Controls.xaml build on them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Each palette brings its own brushes: brushes take their colors when first used, so switching themes needs
         new ones. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Asks for the dark window title bar. -->
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

    <!-- Surfaces and text -->
    <Color x:Key="WindowBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="PaneBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="HeaderBackgroundColor">#FFEDEDED</Color>
    <Color x:Key="BorderColor">#FFD0D0D0</Color>
    <Color x:Key="TextColor">#FF000000</Color>
    <Color x:Key="SubtleTextColor">#FF777777</Color>
    <Color x:Key="HintTextColor">#FF888888</Color>

    <!-- Controls -->
    <Color x:Key="ControlBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ControlBorderColor">#FFAAAAAA</Color>
    <Color x:Key="HoverBackgroundColor">#FFE5F1FB</Color>
    <Color x:Key="HoverBorderColor">#FF7EB4EA</Color>
    <Color x:Key="PressedBackgroundColor">#FFCCE4F7</Color>
    <Color x:Key="CheckedBackgroundColor">#FFD5E8F8</Color>
    <Color x:Key="AccentColor">#FF3C7FB1</Color>
    <Color x:Key="SelectionColor">#FF0078D7</Color>
    <Color x:Key="DisabledTextColor">#FF9E9E9E</Color>
    <Color x:Key="ErrorColor">#FFFF0000</Color>
    <Color x:Key="ScrollBarTrackColor">#FFF0F0F0</Color>
    <Color x:Key="ScrollBarThumbColor">#FFCDCDCD</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FFA6A6A6</Color>
    <Color x:Key="ScrollBarArrowColor">#FF606060</Color>

    <!-- Line numbers -->
    <Color x:Key="GutterBackgroundColor">#FFF4F4F4</Color>
    <Color x:Key="GutterBorderColor">#FFDDDDDD</Color>
    <Color x:Key="GutterTextColor">#FF999999</Color>

    <!-- Diff rows -->
    <Color x:Key="UnmatchedColor">#FFFFC7CE</Color>
    <Color x:Key="ModifiedColor">#FFFFF0A0</Color>
    <Color x:Key="TypeChangedColor">#FFE2CCF7</Color>
    <Color x:Key="IgnoredColor">#FFEEEEEE</Color>
    <Color x:Key="IgnoredTextColor">#FF999999</Color>
    <Color x:Key="FoldColor">#FFE8EEF4</Color>
    <Color x:Key="FoldBorderColor">#FFCCCCCC</Color>
    <Color x:Key="FoldTextColor">#FF777777</Color>
    <!-- The two stripes of the gap hatching. -->
    <Color x:Key="GapColor1">#FFE6E6E6</Color>
    <Color x:Key="GapColor2">#FFF6F6F6</Color>

    <!-- Overview bar: stronger variants for its thin marks. -->
    <Color x:Key="OverviewBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="OverviewSeparatorColor">#FFD3D3D3</Color>
    <Color x:Key="OverviewUnmatchedColor">#FFE06070</Color>
    <Color x:Key="OverviewModifiedColor">#FFE0B000</Color>
    <Color x:Key="OverviewTypeChangedColor">#FF9A60D0</Color>
    <Color x:Key="OverviewIgnoredColor">#FFB0B0B0</Color>
    <Color x:Key="OverviewViewportColor">#304A90D9</Color>
    <Color x:Key="OverviewViewportBorderColor">#FF4A90D9</Color>
</ResourceDictionary>
