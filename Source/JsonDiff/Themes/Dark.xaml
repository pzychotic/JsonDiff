<!-- The dark palette. Every theme defines the same keys; Brushes.xaml and Controls.xaml build on them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Each palette brings its own brushes: brushes take their colors when first used, so switching themes needs
         new ones. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Asks for the dark window title bar. -->
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <!-- Surfaces and text -->
    <Color x:Key="WindowBackgroundColor">#FF202020</Color>
    <Color x:Key="PaneBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="PanelBackgroundColor">#FF2B2B2B</Color>
    <Color x:Key="HeaderBackgroundColor">#FF2D2D30</Color>
    <Color x:Key="BorderColor">#FF3F3F46</Color>
    <Color x:Key="TextColor">#FFE0E0E0</Color>
    <Color x:Key="SubtleTextColor">#FF9A9A9A</Color>
    <Color x:Key="HintTextColor">#FF8A8A8A</Color>

    <!-- Controls -->
    <Color x:Key="ControlBackgroundColor">#FF333337</Color>
    <Color x:Key="ControlBorderColor">#FF5A5A5E</Color>
    <Color x:Key="HoverBackgroundColor">#FF3E3E42</Color>
    <Color x:Key="HoverBorderColor">#FF5A8FC4</Color>
    <Color x:Key="PressedBackgroundColor">#FF094771</Color>
    <Color x:Key="CheckedBackgroundColor">#FF2F4F6F</Color>
    <Color x:Key="AccentColor">#FF4A90D9</Color>
    <Color x:Key="SelectionColor">#FF264F78</Color>
    <Color x:Key="DisabledTextColor">#FF6E6E6E</Color>
    <Color x:Key="ErrorColor">#FFF14C4C</Color>
    <Color x:Key="ScrollBarTrackColor">#FF252526</Color>
    <Color x:Key="ScrollBarThumbColor">#FF4E4E52</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF6E6E72</Color>
    <Color x:Key="ScrollBarArrowColor">#FF9A9A9A</Color>

    <!-- Line numbers -->
    <Color x:Key="GutterBackgroundColor">#FF252526</Color>
    <Color x:Key="GutterBorderColor">#FF3A3A3D</Color>
    <Color x:Key="GutterTextColor">#FF858585</Color>

    <!-- Diff rows -->
    <Color x:Key="UnmatchedColor">#FF5A2A30</Color>
    <Color x:Key="ModifiedColor">#FF4D4520</Color>
    <Color x:Key="TypeChangedColor">#FF3E2F55</Color>
    <Color x:Key="IgnoredColor">#FF2A2A2A</Color>
    <Color x:Key="IgnoredTextColor">#FF7A7A7A</Color>
    <Color x:Key="FoldColor">#FF26313C</Color>
    <Color x:Key="FoldBorderColor">#FF3A4654</Color>
    <Color x:Key="FoldTextColor">#FF9AA5B1</Color>
    <!-- The two stripes of the gap hatching. -->
    <Color x:Key="GapColor1">#FF2A2A2A</Color>
    <Color x:Key="GapColor2">#FF222222</Color>

    <!-- Search hits: orange, a hue no diff color uses. -->
    <Color x:Key="SearchMatchColor">#FF6B4520</Color>
    <Color x:Key="SearchCurrentColor">#FFD9822B</Color>
    <Color x:Key="SearchCurrentTextColor">#FF1E1E1E</Color>

    <!-- Overview bar: stronger variants for its thin marks. -->
    <Color x:Key="OverviewBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="OverviewSeparatorColor">#FF3F3F46</Color>
    <Color x:Key="OverviewUnmatchedColor">#FFD05060</Color>
    <Color x:Key="OverviewModifiedColor">#FFC8A020</Color>
    <Color x:Key="OverviewTypeChangedColor">#FF9A6AD0</Color>
    <Color x:Key="OverviewIgnoredColor">#FF707070</Color>
    <Color x:Key="OverviewSearchColor">#FFE8913A</Color>
    <Color x:Key="OverviewViewportColor">#404A90D9</Color>
    <Color x:Key="OverviewViewportBorderColor">#FF5A9FE6</Color>
</ResourceDictionary>
