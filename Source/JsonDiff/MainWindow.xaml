<Window x:Class="JsonDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:beh="clr-namespace:JsonDiff.Behaviors"
        xmlns:views="clr-namespace:JsonDiff.Views"
        xmlns:vm="clr-namespace:JsonDiff.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Title="JsonDiff" Height="700" Width="1200">

    <!-- The gestures shown via InputGestureText in the menu below. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding OpenLeftCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding OpenRightCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FilePaneViewModel}">
            <views:JsonPaneView />
        </DataTemplate>

        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="BorderBrush" Value="#FFAAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="10,0,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Left…" Command="{Binding OpenLeftCommand}" InputGestureText="Ctrl+1" />
                <MenuItem Header="Open _Right…" Command="{Binding OpenRightCommand}" InputGestureText="Ctrl+2" />
                <MenuItem Header="Re_load" Command="{Binding ReloadCommand}" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Sort Keys" IsCheckable="True" IsChecked="{Binding SortKeys}" />
                <MenuItem Header="Compare _Numbers" IsCheckable="True" IsChecked="{Binding CompareNumbers}" />
                <MenuItem Header="S_wap Sides" Command="{Binding SwapCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Open Left…" Command="{Binding OpenLeftCommand}" ToolTip="Open Left (Ctrl+1)" />
                <Button Content="Open Right…" Command="{Binding OpenRightCommand}" ToolTip="Open Right (Ctrl+2)" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Reload both files (F5)" />
                <Separator />
                <Button Content="Swap" Command="{Binding SwapCommand}" ToolTip="Swap left and right" />
                <ToggleButton Content="Sort Keys" IsChecked="{Binding SortKeys}"
                              ToolTip="Show object keys in alphabetical order" />
                <Separator />
                <ToggleButton Content="Numbers" IsChecked="{Binding CompareNumbers}"
                              ToolTip="Compare numbers and numeric strings by value, within the tolerance" />
                <TextBlock Text="±" VerticalAlignment="Center" Margin="4,0,2,0" />
                <TextBox Width="70" VerticalContentAlignment="Center"
                         Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CompareNumbers}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static ToolBar.TextBoxStyleKey}}">
                            <Setter Property="ToolTip" Value="Largest difference at which two numbers are still equal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToleranceValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red" />
                                    <Setter Property="ToolTip" Value="Enter a number ≥ 0, e.g. 0.0005" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar with color legend -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource UnmatchedBrush}" />
                    <TextBlock Text="Only on this side" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource ModifiedBrush}" />
                    <TextBlock Text="Different value" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource TypeChangedBrush}" />
                    <TextBlock Text="Different type" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource IgnoredBrush}" />
                    <TextBlock Text="Ignored" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource GapBrush}" />
                    <TextBlock Text="Gap" Margin="0,0,6,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Side-by-side panes; each is a drop target for its side and scrolls in sync with the other. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding Left}" Focusable="False">
                <b:Interaction.Behaviors>
                    <beh:DropBehavior Command="{Binding DropLeftCommand}" />
                    <beh:ScrollSyncBehavior Group="Panes" />
                </b:Interaction.Behaviors>
            </ContentControl>

            <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="#FFD0D0D0" />

            <ContentControl Grid.Column="2" Content="{Binding Right}" Focusable="False">
                <b:Interaction.Behaviors>
                    <beh:DropBehavior Command="{Binding DropRightCommand}" />
                    <beh:ScrollSyncBehavior Group="Panes" />
                </b:Interaction.Behaviors>
            </ContentControl>
        </Grid>
    </DockPanel>
</Window>
