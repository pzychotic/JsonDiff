<Window x:Class="JsonDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:beh="clr-namespace:JsonDiff.Behaviors"
        xmlns:controls="clr-namespace:JsonDiff.Controls"
        xmlns:conv="clr-namespace:JsonDiff.Converters"
        xmlns:m="clr-namespace:JsonDiff.Models"
        xmlns:views="clr-namespace:JsonDiff.Views"
        xmlns:vm="clr-namespace:JsonDiff.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Title="JsonDiff" Height="700" Width="1200">

    <!-- The gestures shown via InputGestureText in the menu below. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding OpenLeftCommand}" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding OpenRightCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="F8" Command="{Binding NextDifferenceCommand}" />
        <KeyBinding Modifiers="Shift" Key="F8" Command="{Binding PreviousDifferenceCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <DataTemplate DataType="{x:Type vm:FilePaneViewModel}">
            <views:JsonPaneView />
        </DataTemplate>

        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="10,0,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Left…" Command="{Binding OpenLeftCommand}" InputGestureText="Ctrl+1" />
                <MenuItem Header="Open _Right…" Command="{Binding OpenRightCommand}" InputGestureText="Ctrl+2" />
                <MenuItem Header="Re_load" Command="{Binding ReloadCommand}" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Sort Keys" IsCheckable="True" IsChecked="{Binding SortKeys}" />
                <MenuItem Header="Compare _Numbers" IsCheckable="True" IsChecked="{Binding CompareNumbers}" />
                <MenuItem Header="S_wap Sides" Command="{Binding SwapCommand}" />
                <Separator />
                <MenuItem Header="Show _Changes Only" IsCheckable="True" IsChecked="{Binding ShowChangesOnly}" />
                <MenuItem Header="Show _Overview" IsCheckable="True" IsChecked="{Binding ShowOverview}" />
                <MenuItem Header="Ne_xt Difference" Command="{Binding NextDifferenceCommand}" InputGestureText="F8" />
                <MenuItem Header="_Previous Difference" Command="{Binding PreviousDifferenceCommand}"
                          InputGestureText="Shift+F8" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="_System" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static m:AppTheme.System}"
                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals},
                                          ConverterParameter={x:Static m:AppTheme.System}}" />
                    <MenuItem Header="_Light" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static m:AppTheme.Light}"
                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals},
                                          ConverterParameter={x:Static m:AppTheme.Light}}" />
                    <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static m:AppTheme.Dark}"
                              IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals},
                                          ConverterParameter={x:Static m:AppTheme.Dark}}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Open Left…" Command="{Binding OpenLeftCommand}" ToolTip="Open Left (Ctrl+1)" />
                <Button Content="Open Right…" Command="{Binding OpenRightCommand}" ToolTip="Open Right (Ctrl+2)" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Reload both files (F5)" />
                <Separator />
                <Button Content="Swap" Command="{Binding SwapCommand}" ToolTip="Swap left and right" />
                <ToggleButton Content="Sort Keys" IsChecked="{Binding SortKeys}"
                              ToolTip="Show object keys in alphabetical order" />
                <Separator />
                <ToggleButton Content="Numbers" IsChecked="{Binding CompareNumbers}"
                              ToolTip="Compare numbers and numeric strings by value, within the tolerance" />
                <TextBlock Text="±" VerticalAlignment="Center" Margin="4,0,2,0" />
                <TextBox Width="70" VerticalContentAlignment="Center"
                         Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CompareNumbers}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static ToolBar.TextBoxStyleKey}}">
                            <Setter Property="ToolTip" Value="Largest difference at which two numbers are still equal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToleranceValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    <Setter Property="ToolTip" Value="Enter a number ≥ 0, e.g. 0.0005" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Separator />
                <ToggleButton Content="Changes Only" IsChecked="{Binding ShowChangesOnly}"
                              ToolTip="Show only the differences and the lines around them" />
                <TextBlock Text="Context" VerticalAlignment="Center" Margin="4,0,2,0" />
                <TextBox Width="30" VerticalContentAlignment="Center"
                         Text="{Binding ContextLinesText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding ShowChangesOnly}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static ToolBar.TextBoxStyleKey}}">
                            <Setter Property="ToolTip" Value="Unchanged lines shown above and below each difference" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContextLinesValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    <Setter Property="ToolTip" Value="Enter a whole number from 0 to 99" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Content="▲ Prev" Command="{Binding PreviousDifferenceCommand}"
                        ToolTip="Previous difference (Shift+F8)" />
                <Button Content="▼ Next" Command="{Binding NextDifferenceCommand}" ToolTip="Next difference (F8)" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar with color legend -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource UnmatchedBrush}" />
                    <TextBlock Text="Only on this side" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource ModifiedBrush}" />
                    <TextBlock Text="Different value" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource TypeChangedBrush}" />
                    <TextBlock Text="Different type" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource IgnoredBrush}" />
                    <TextBlock Text="Ignored" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource GapBrush}" />
                    <TextBlock Text="Gap" />
                    <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource FoldBrush}" />
                    <TextBlock Text="Hidden lines" Margin="0,0,6,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Side-by-side panes; each is a drop target for its side and scrolls in sync with the other. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!-- Overview of both sides' differences, spanning the rows below the pane headers; scrolls the left pane,
                 which the right one follows. -->
            <DockPanel Grid.Column="0"
                       Visibility="{Binding ShowOverview, Converter={StaticResource BooleanToVisibility}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" BorderThickness="0,0,1,1">
                    <TextBlock Text=" " FontWeight="SemiBold" />
                </Border>
                <!-- Room for the panes' horizontal scroll bars. -->
                <Border DockPanel.Dock="Bottom" Height="{x:Static SystemParameters.HorizontalScrollBarHeight}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <controls:DiffOverviewBar Width="20" Cursor="Hand" ToolTip="Click or drag to scroll"
                                              LeftLines="{Binding Left.Lines}" RightLines="{Binding Right.Lines}"
                                              TopRow="{Binding Left.TopRow}" ViewportRows="{Binding Left.ViewportRows}"
                                              Background="{DynamicResource OverviewBackgroundBrush}"
                                              SeparatorBrush="{DynamicResource OverviewSeparatorBrush}"
                                              UnmatchedBrush="{DynamicResource OverviewUnmatchedBrush}"
                                              ModifiedBrush="{DynamicResource OverviewModifiedBrush}"
                                              TypeChangedBrush="{DynamicResource OverviewTypeChangedBrush}"
                                              IgnoredBrush="{DynamicResource OverviewIgnoredBrush}"
                                              ViewportBrush="{DynamicResource OverviewViewportBrush}"
                                              ViewportBorderBrush="{DynamicResource OverviewViewportBorderBrush}" />
                </Border>
            </DockPanel>

            <ContentControl Grid.Column="1" Content="{Binding Left}" Focusable="False">
                <b:Interaction.Behaviors>
                    <beh:DropBehavior Command="{Binding DropLeftCommand}" />
                    <beh:ScrollSyncBehavior Group="Panes" />
                </b:Interaction.Behaviors>
            </ContentControl>

            <GridSplitter Grid.Column="2" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="{DynamicResource BorderBrush}" />

            <ContentControl Grid.Column="3" Content="{Binding Right}" Focusable="False">
                <b:Interaction.Behaviors>
                    <beh:DropBehavior Command="{Binding DropRightCommand}" />
                    <beh:ScrollSyncBehavior Group="Panes" />
                </b:Interaction.Behaviors>
            </ContentControl>
        </Grid>
    </DockPanel>
</Window>
