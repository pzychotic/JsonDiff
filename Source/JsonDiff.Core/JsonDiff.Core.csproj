<Project Sdk="Microsoft.NET.Sdk">

  <!-- The diff engine shared by the WPF app and the CLI; must stay free of WPF so the CLI runs anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JsonDiff.Tests" />
  </ItemGroup>

  <!-- Copied next to every executable that references this library. Shipped as an example, never as MatchRules.json,
       so that extracting a new release cannot overwrite a rules file the user edited. -->
  <ItemGroup>
    <Content Include="MatchRules.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
